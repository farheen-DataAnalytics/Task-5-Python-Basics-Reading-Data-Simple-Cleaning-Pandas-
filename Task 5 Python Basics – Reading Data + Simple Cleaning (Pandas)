    "        return \"Excellent\"\n",
    "    elif gpa >= 2.5:\n",
    "        return \"Good\"\n",
    "    elif gpa >= 1.5:\n",
    "        return \"Average\"\n",
    "    else:\n",
    "        return \"Poor\"\n",
